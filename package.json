{
  "name": "gmail-unsubscribe",
  "version": "1.0.0",
  "description": "A tool to automatically unsubscribe from promotional emails in Gmail",
  "main": "src/main.js",
  "scripts": {
    "start": "node src/main.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "agent:process": "node scripts/agents/processEmails.js",
    "agent:cleanup": "node scripts/agents/cleanup.js",
    "agent:report": "node scripts/agents/generateReport.js",
    "agent:monitor": "node scripts/agents/monitor.js",
    "agent:all": "npm run agent:cleanup && npm run agent:process && npm run agent:report",
    "agent:health": "npm run agent:monitor"
  },
  "keywords": [
    "gmail",
    "unsubscribe",
    "email",
    "automation"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.12.2",
    "cheerio": "^1.0.0-rc.12",
    "dotenv": "^16.3.1",
    "googleapis": "^129.0.0",
    "openai": "^4.100.0",
    "puppeteer": "^24.9.0"
  }
}
