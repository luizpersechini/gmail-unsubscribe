# Server
APP_PORT=4000
HOST=0.0.0.0

# Gmail OAuth
CLIENT_ID=
CLIENT_SECRET=
REDIRECT_URI=http://localhost:4000/oauth2callback

# DeepSeek AI
DEEPSEEK_API_KEY=

# Processing Settings
MAX_EMAILS_TO_PROCESS=20
AUTO_CONTINUE=true
DELETE_AFTER_UNSUBSCRIBE=false
PERMANENT_DELETE=false
MAX_CONCURRENT_JOBS=1
RETRY_COUNT=2

# Storage Paths
DATA_DIR=./data
LOGS_DIR=./logs
SCREENSHOTS_DIR=./screenshots
