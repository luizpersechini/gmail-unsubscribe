{
  "name": "gmail-unsubscribe",
  "version": "1.0.0",
  "description": "A tool to automatically unsubscribe from promotional emails in Gmail",
  "main": "src/server/index.js",
  "scripts": {
    "start": "node src/server/index.js",
    "server": "node src/server/index.js",
    "server:dev": "nodemon src/server/index.js",
    "dev": "concurrently --kill-others-on-fail \"npm:server:dev\" \"npm:web:dev\"",
    "web:dev": "vite --config web/vite.config.mjs",
    "web:build": "vite build --config web/vite.config.mjs",
    "web:preview": "vite preview --config web/vite.config.mjs",
    "build": "npm run web:build",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint ."
  },
  "keywords": [
    "gmail",
    "unsubscribe",
    "email",
    "automation"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.12.2",
    "cheerio": "^1.0.0-rc.12",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.19.2",
    "googleapis": "^129.0.0",
    "helmet": "^7.0.0",
    "morgan": "^1.10.0",
    "openai": "^4.100.0",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "puppeteer": "^24.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "eslint": "^9.12.0",
    "eslint-plugin-react": "^7.37.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^16.5.0",
    "nodemon": "^3.1.7",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "vite": "^5.4.10"
  }
}
